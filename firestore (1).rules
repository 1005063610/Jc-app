rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isBoss() { return signedIn() && profile().role == 'boss'; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isBoss());
      allow create: if (isBoss() && request.resource.data.role in ['boss', 'collector']) ||
        (signedIn() && request.auth.uid == uid && request.resource.data.role == 'boss' && request.resource.data.provider == 'google.com' && request.resource.data.email == request.auth.token.email);
      allow update: if isBoss() || request.auth.uid == uid;
      allow delete: if isBoss() && uid != request.auth.uid;
    }

    match /clients/{id} {
      allow read: if isBoss() || owns(resource.data) || (signedIn() && 'assignedTo' in resource.data && request.auth.uid in resource.data.assignedTo);
      allow create: if isBoss() && owns(request.resource.data);
      allow update: if (isBoss() || (signedIn() && 'assignedTo' in resource.data && request.auth.uid in resource.data.assignedTo)) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isBoss() && owns(resource.data);
    }

    match /expenses/{id} {
      allow read: if isBoss() || owns(resource.data);
      allow create: if isBoss() && owns(request.resource.data);
      allow update, delete: if isBoss() && owns(resource.data);
    }

    match /payments/{id} {
      allow read: if isBoss() || owns(resource.data);
      allow create: if signedIn() && owns(request.resource.data);
      allow update, delete: if false;
    }

    match /gps_live/{uid} {
      allow read: if isBoss();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isBoss() || request.auth.uid == uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
